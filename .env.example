OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5.4-mini

MAX_TOOL_ROUNDS=4
MAX_MEMORY_TURNS=8

SYSTEM_PROMPT=You are a safe, task-oriented game-development production assistant. Use project tools when they are relevant. Do not invent project policies or expose secrets.

OPENAI_INPUT_COST_PER_MILLION=0.75
OPENAI_OUTPUT_COST_PER_MILLION=4.50

RESULTS_DIRECTORY=results/interactive_runtime